импорт Продажи
импорт Занятия

@Обработчик
метод ПослеСоздания()
    ЗаполнитьКарточки()
;

метод ЗаполнитьКарточки()
    ЗаполнитьКарточкуВыручка()
    ЗаполнитьКарточкуЗанятия()
    ЗаполнитьКарточкуАбонементы()
;

метод ЗаполнитьКарточкуВыручка()
    Компоненты.НадписьВыручка.Значение = "${ПолучитьВыручкуЗаМесяц()} ₽"
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьВыручкуЗаМесяц(): Число
    знч ГраницаДаты = ДатаВремя.Сейчас().ДобавитьДни(-30)
    знч Запрос = Запрос{
        ВЫБРАТЬ
            СУММА(В.СуммаОборот) КАК Сумма
        ИЗ
            Выручка.Обороты КАК В
        ГДЕ
            В.Период >= %ГраницаДаты
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 0
    ;
    возврат Строка.Сумма ?? 0
;

метод ЗаполнитьКарточкуЗанятия()
    Компоненты.НадписьЗанятия.Значение = ПолучитьКоличествоЗанятий().Представление()
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьКоличествоЗанятий(): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
        ИЗ Занятие
        ГДЕ Отменено == Ложь
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено().Количество
;

метод ЗаполнитьКарточкуАбонементы()
    Компоненты.НадписьАбонементы.Значение = ПолучитьКоличествоАбонементов().Представление()
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьКоличествоАбонементов(): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
        ИЗ ПродажаАбонемента
    }
    возврат Запрос.Выполнить().ПервыйИлиНеопределено().Количество
;
