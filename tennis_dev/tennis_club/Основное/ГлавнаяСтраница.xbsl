импорт Продажи
импорт Занятия

@Обработчик
метод ПослеСоздания()
    ЗаполнитьКарточки()
;

метод ЗаполнитьКарточки()
    ЗаполнитьКарточкуВыручка()
    ЗаполнитьКарточкуЗанятия()
    ЗаполнитьКарточкуАбонементы()
    НастроитьДиаграммы()
    ОбновитьПодписьПериода()
    ЗаполнитьДиаграммы()
;

метод НеделяНазадПриНажатии(Команда: ОбычнаяКоманда)
    НедельноеСмещение = НедельноеСмещение - 1
    ОбновитьПодписьПериода()
    ЗаполнитьДиаграммы()
;

метод НеделяВпередПриНажатии(Команда: ОбычнаяКоманда)
    если НедельноеСмещение < 0
        НедельноеСмещение = НедельноеСмещение + 1
        ОбновитьПодписьПериода()
        ЗаполнитьДиаграммы()
    ;
;

метод ОбновитьПодписьПериода()
    знч КонецОкна = ДатаВремя.Сейчас().ДобавитьДни(НедельноеСмещение * 7)
    знч НачалоОкна = КонецОкна.ДобавитьДни(-6)
    Компоненты.НадписьПериодДиаграммы.Значение = НачалоОкна.Представление("дд.ММ") + " – " + КонецОкна.Представление("дд.ММ")
;

метод НастроитьДиаграммы()
    знч Диаграмма = Компоненты.ДиаграммаВыручка

    знч ОсьX = новый КатегориальнаяОсьДиаграммы()
    ОсьX.ПолеДанных.ПолеЗначения = "День"
    ОсьX.ПолеДанных.ОтображаемоеЗначение = "День"
    Диаграмма.ОсиX.Добавить(ОсьX)

    знч ОсьY = новый ЧисловаяОсьДиаграммы()
    ОсьY.Заголовок = "Выручка"
    Диаграмма.ОсиY.Добавить(ОсьY)

    знч Серия = новый СтолбчатаяСерияДиаграммы()
    Серия.Имя = "Выручка"
    Серия.ПоляДанных.Ключ.ПолеЗначения = "День"
    Серия.ПоляДанных.Значение.ПолеЗначения = "Сумма"
    Серия.Ось = ОсьY
    Диаграмма.Серии.Добавить(Серия)
;

метод ЗаполнитьДиаграммы()
    Компоненты.ДиаграммаВыручка.Источник.Данные = ПолучитьВыручкуПоДням(НедельноеСмещение)
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьВыручкуПоДням(Смещение: Число): Массив<СтрокаВыручкиПоДням>
    знч КонецОкна = ДатаВремя.Сейчас().ДобавитьДни(Смещение * 7)
    знч Результат = новый Массив<СтрокаВыручкиПоДням>()
    пер i = 6
    пока i >= 0
        знч НачалоПериода = КонецОкна.ДобавитьДни(-(i + 1))
        знч КонецПериода = КонецОкна.ДобавитьДни(-i)
        знч Запрос = Запрос{
            ВЫБРАТЬ
                СУММА(В.Сумма).ЗаменитьNull(0) КАК Сумма
            ИЗ
                Выручка КАК В
            ГДЕ
                В.Период >= %НачалоПериода И В.Период < %КонецПериода
        }
        знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
        пер Сумма = 0
        если Строка != Неопределено
            Сумма = Строка.Сумма
        ;
        Результат.Добавить(новый СтрокаВыручкиПоДням(День = КонецПериода.Представление("дд.ММ"), Сумма = Сумма))
        i = i - 1
    ;
    возврат Результат
;

метод ЗаполнитьКарточкуВыручка()
    Компоненты.НадписьВыручка.Значение = "${ПолучитьВыручкуЗаМесяц()} ₽"
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьВыручкуЗаМесяц(): Число
    знч ГраницаДаты = ДатаВремя.Сейчас().ДобавитьДни(-30)
    знч Запрос = Запрос{
        ВЫБРАТЬ
            СУММА(В.Сумма).ЗаменитьNull(0) КАК Сумма
        ИЗ
            Выручка КАК В
        ГДЕ
            В.Период >= %ГраницаДаты
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 0
    ;
    возврат Строка.Сумма
;

метод ЗаполнитьКарточкуЗанятия()
    Компоненты.НадписьЗанятия.Значение = ПолучитьКоличествоЗанятий().Представление()
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьКоличествоЗанятий(): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
        ИЗ Занятие
        ГДЕ Отменено == Ложь
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 0
    ;
    возврат Строка.Количество
;

метод ЗаполнитьКарточкуАбонементы()
    Компоненты.НадписьАбонементы.Значение = ПолучитьКоличествоАбонементов().Представление()
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьКоличествоАбонементов(): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
        ИЗ ПродажаАбонемента
    }
    знч Строка = Запрос.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 0
    ;
    возврат Строка.Количество
;
