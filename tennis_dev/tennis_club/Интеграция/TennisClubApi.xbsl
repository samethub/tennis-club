импорт НСИ
импорт Занятия

метод ОтветОшибка(Запрос: HttpСервисЗапрос, Статус: Число, Код: Строка, Сообщение: Строка)
    Запрос.Ответ.УстановитьКодСтатуса(Статус)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, {"code": Код, "message": Сообщение})
;

структура БронированиеЗапрос
    пер clientId: Строка
    пер format: Строка
    пер courtId: Строка?
    пер coachId: Строка?
    пер startAt: ДатаВремя?
    пер durationMinutes: Число?
    пер groupSessionId: Строка?
;

метод СоздатьБронирование(Запрос: HttpСервисЗапрос)
    знч Данные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<БронированиеЗапрос>)

    если Данные.format != "INDIVIDUAL"
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Поддерживается только format=INDIVIDUAL")
        возврат
    ;
    если Данные.courtId == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан courtId")
        возврат
    ;
    если Данные.startAt == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан startAt")
        возврат
    ;

    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(Данные.clientId))
    знч КортСсылка = новый Корты.Ссылка(новый Ууид(Данные.courtId))

    пер ТренерСсылка: Тренеры.Ссылка? = Неопределено
    если Данные.coachId != Неопределено
        ТренерСсылка = новый Тренеры.Ссылка(новый Ууид(Данные.coachId))
    ;

    знч НовоеЗанятие = новый Занятие.Объект()
    НовоеЗанятие.Формат = ФорматыЗанятий.Индивидуальное
    НовоеЗанятие.Клиент = КлиентСсылка
    НовоеЗанятие.Корт = КортСсылка
    НовоеЗанятие.Тренер = ТренерСсылка
    НовоеЗанятие.Дата = Данные.startAt
    если Данные.durationMinutes != Неопределено
        НовоеЗанятие.Количество = Данные.durationMinutes / 45
    ;

    попытка
        НовоеЗанятие.Записать()
    поймать Ошибка: Исключение
        ОтветОшибка(Запрос, 409, "BOOKING_SLOT_NOT_AVAILABLE", Ошибка.Описание)
        возврат
    ;

    Запрос.Ответ.УстановитьКодСтатуса(201)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч ПотокОтвета = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(ПотокОтвета, {
        "id": НовоеЗанятие.Ссылка.Ид.ВСтроку(),
        "status": "CONFIRMED",
        "format": "INDIVIDUAL",
        "courtId": Данные.courtId,
        "coachId": Данные.coachId,
        "startAt": НовоеЗанятие.Дата.Представление("гггг-ММ-ддTЧЧ:мм:сс"),
        "endAt": НовоеЗанятие.Дата.ДобавитьМинуты(НовоеЗанятие.Длительность).Представление("гггг-ММ-ддTЧЧ:мм:сс"),
        "price": НовоеЗанятие.Цена
    })
;

структура КлиентЗапрос
    пер externalId: Строка
    пер fullName: Строка
;

метод СоздатьКлиента(Запрос: HttpСервисЗапрос)
    знч Данные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<КлиентЗапрос>)

    знч ВнешнийИдЗначение = Данные.externalId
    знч ЗапросПоиска = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка
        ИЗ Клиенты КАК К
        ГДЕ К.ВнешнийИд == %ВнешнийИдЗначение
    }
    знч СтрокаПоиска = ЗапросПоиска.Выполнить().ПервыйИлиНеопределено()

    пер КлиентСсылка: Клиенты.Ссылка? = Неопределено
    если СтрокаПоиска != Неопределено
        КлиентСсылка = СтрокаПоиска.Ссылка
    иначе
        знч НовыйКлиент = новый Клиенты.Объект()
        НовыйКлиент.Наименование = Данные.fullName
        НовыйКлиент.ВнешнийИд = Данные.externalId
        НовыйКлиент.Записать()
        КлиентСсылка = НовыйКлиент.Ссылка
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, {"id": КлиентСсылка?.Ид.ВСтроку()})
;

метод ПолучитьКорты(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            К.Ссылка КАК Ссылка,
            К.Наименование КАК Наименование,
            К.ТипПокрытия КАК ТипПокрытия
        ИЗ Корты КАК К
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Строка>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "name": Строка.Наименование,
            "type": Строка.ТипПокрытия
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьТренеров(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            Т.Ссылка КАК Ссылка,
            Т.Наименование КАК Наименование,
            Т.Специализация КАК Специализация
        ИЗ Тренеры КАК Т
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Строка>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "fullName": Строка.Наименование,
            "specialization": Строка.Специализация
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьТипыАбонементов(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            Т.Ссылка КАК Ссылка,
            Т.Наименование КАК Наименование,
            Т.КоличествоИндивидуальных КАК КоличествоИндивидуальных,
            Т.КоличествоГрупповых КАК КоличествоГрупповых,
            Т.СрокДействияДней КАК СрокДействияДней,
            Т.Цена КАК Цена
        ИЗ ТипыАбонементов КАК Т
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Объект>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "name": Строка.Наименование,
            "individualSessions": Строка.КоличествоИндивидуальных,
            "groupSessions": Строка.КоличествоГрупповых,
            "validDays": Строка.СрокДействияДней,
            "price": Строка.Цена
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;
