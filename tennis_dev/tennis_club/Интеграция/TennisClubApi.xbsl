импорт НСИ
импорт Занятия
импорт Продажи

метод ОтветОшибка(Запрос: HttpСервисЗапрос, Статус: Число, Код: Строка, Сообщение: Строка)
    Запрос.Ответ.УстановитьКодСтатуса(Статус)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, {"code": Код, "message": Сообщение})
;

// ISO 8601 без таймзоны: гггг-ММ-ддTЧЧ:мм:сс - собираем конкатенацией, без формат-строки
// с буквой T внутри (подозрение, что движок форматирования её не экранирует как литерал).
метод КСтрокеISO(Дата: ДатаВремя): Строка
    возврат Дата.Представление("гггг-ММ-дд") + "T" + Дата.Представление("ЧЧ:мм:сс")
;

структура АбонементЗапрос
    пер clientId: Строка
    пер subscriptionTypeId: Строка
;

метод КупитьАбонемент(Запрос: HttpСервисЗапрос)
    знч Данные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<АбонементЗапрос>)

    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(Данные.clientId))
    знч ЗапросКлиента = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка ИЗ Клиенты КАК К ГДЕ К.Ссылка == %КлиентСсылка}
    если ЗапросКлиента.Выполнить().ПервыйИлиНеопределено() == Неопределено
        ОтветОшибка(Запрос, 404, "CLIENT_NOT_FOUND", "Клиент не найден")
        возврат
    ;

    знч ТипСсылка = новый ТипыАбонементов.Ссылка(новый Ууид(Данные.subscriptionTypeId))
    знч ЗапросТипа = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Т.Наименование КАК Наименование,
            Т.СрокДействияДней КАК СрокДействияДней,
            Т.КоличествоИндивидуальных КАК КоличествоИндивидуальных,
            Т.КоличествоГрупповых КАК КоличествоГрупповых
        ИЗ ТипыАбонементов КАК Т
        ГДЕ Т.Ссылка == %ТипСсылка
    }
    знч СтрокаТипа = ЗапросТипа.Выполнить().ПервыйИлиНеопределено()
    если СтрокаТипа == Неопределено
        ОтветОшибка(Запрос, 404, "SUBSCRIPTION_TYPE_NOT_FOUND", "Тип абонемента не найден")
        возврат
    ;

    знч НоваяПродажа = новый ПродажаАбонемента.Объект()
    НоваяПродажа.Дата = ДатаВремя.Сейчас()
    НоваяПродажа.Клиент = КлиентСсылка
    НоваяПродажа.ТипАбонемента = ТипСсылка

    попытка
        НоваяПродажа.Записать()
    поймать Ошибка: Исключение
        ОтветОшибка(Запрос, 500, "INTERNAL_ERROR", Ошибка.Описание)
        возврат
    ;

    Запрос.Ответ.УстановитьКодСтатуса(201)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Ответ = новый Соответствие<Строка, Объект>()
    Ответ.Вставить("id", НоваяПродажа.Ссылка.Ид.ВСтроку())
    Ответ.Вставить("typeName", СтрокаТипа.Наименование)
    Ответ.Вставить("purchasedAt", КСтрокеISO(НоваяПродажа.Дата))
    Ответ.Вставить("expiresAt", КСтрокеISO(НоваяПродажа.Дата.ДобавитьДни(СтрокаТипа.СрокДействияДней)))
    Ответ.Вставить("price", НоваяПродажа.Цена)
    Ответ.Вставить("individualRemaining", СтрокаТипа.КоличествоИндивидуальных)
    Ответ.Вставить("groupRemaining", СтрокаТипа.КоличествоГрупповых)
    СериализацияJson.ЗаписатьОбъект(Поток, Ответ)
;

метод ПолучитьАбонементы(Запрос: HttpСервисЗапрос)
    знч КлиентИдСтрокой = Запрос.Параметры.ПолучитьПервый("clientId")
    если КлиентИдСтрокой == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан clientId")
        возврат
    ;
    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(КлиентИдСтрокой))
    знч Сейчас = ДатаВремя.Сейчас()

    знч ЗапросПродаж = Запрос{
        ВЫБРАТЬ
            П.Ссылка КАК Ссылка,
            П.Дата КАК Дата,
            П.ТипАбонемента КАК ТипАбонемента
        ИЗ ПродажаАбонемента КАК П
        ГДЕ П.Клиент == %КлиентСсылка
    }.Выполнить()

    пер ОбщийИнд = 0
    пер ОбщийГруп = 0
    знч Позиции = новый Массив<Соответствие<Строка, Объект>>()

    для СтрокаПрод из ЗапросПродаж
        знч АбонементСсылка = СтрокаПрод.Ссылка
        знч ТипСсылка = СтрокаПрод.ТипАбонемента
        знч ДатаПокупки = СтрокаПрод.Дата

        знч ЗапросТипа = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Т.Наименование КАК Наименование, Т.СрокДействияДней КАК СрокДействияДней, Т.Цена КАК Цена
            ИЗ ТипыАбонементов КАК Т
            ГДЕ Т.Ссылка == %ТипСсылка
        }
        знч СтрокаТипа = ЗапросТипа.Выполнить().ПервыйИлиНеопределено()

        если СтрокаТипа != Неопределено
            знч ДатаОкончания = ДатаПокупки.ДобавитьДни(СтрокаТипа.СрокДействияДней)
            если ДатаОкончания >= Сейчас
                знч ЗапросИнд = Запрос{
                    ВЫБРАТЬ ПЕРВЫЕ 1 О.КоличествоЗанятийОстаток КАК Остаток
                    ИЗ ОстаткиАбонементов.Остатки КАК О
                    ГДЕ О.Клиент == %КлиентСсылка И О.Абонемент == %АбонементСсылка И О.ТипПула == ТипыПулаЗанятий.Индивидуальные
                }
                знч СтрокаИнд = ЗапросИнд.Выполнить().ПервыйИлиНеопределено()
                пер ОстатокИнд = 0
                если СтрокаИнд != Неопределено
                    ОстатокИнд = СтрокаИнд.Остаток
                ;

                знч ЗапросГруп = Запрос{
                    ВЫБРАТЬ ПЕРВЫЕ 1 О.КоличествоЗанятийОстаток КАК Остаток
                    ИЗ ОстаткиАбонементов.Остатки КАК О
                    ГДЕ О.Клиент == %КлиентСсылка И О.Абонемент == %АбонементСсылка И О.ТипПула == ТипыПулаЗанятий.Групповые
                }
                знч СтрокаГруп = ЗапросГруп.Выполнить().ПервыйИлиНеопределено()
                пер ОстатокГруп = 0
                если СтрокаГруп != Неопределено
                    ОстатокГруп = СтрокаГруп.Остаток
                ;

                пер ЕстьОстаток = Ложь
                если ОстатокИнд > 0
                    ЕстьОстаток = Истина
                ;
                если ОстатокГруп > 0
                    ЕстьОстаток = Истина
                ;
                если ЕстьОстаток
                    ОбщийИнд = ОбщийИнд + ОстатокИнд
                    ОбщийГруп = ОбщийГруп + ОстатокГруп

                    знч Элемент = новый Соответствие<Строка, Объект>()
                    Элемент.Вставить("id", АбонементСсылка.Ид.ВСтроку())
                    Элемент.Вставить("typeName", СтрокаТипа.Наименование)
                    Элемент.Вставить("purchasedAt", КСтрокеISO(ДатаПокупки))
                    Элемент.Вставить("expiresAt", КСтрокеISO(ДатаОкончания))
                    Элемент.Вставить("price", СтрокаТипа.Цена)
                    Элемент.Вставить("individualRemaining", ОстатокИнд)
                    Элемент.Вставить("groupRemaining", ОстатокГруп)
                    Позиции.Добавить(Элемент)
                ;
            ;
        ;
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч ПотокОтвета = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч ОтветБаланс = новый Соответствие<Строка, Объект>()
    ОтветБаланс.Вставить("individualRemaining", ОбщийИнд)
    ОтветБаланс.Вставить("groupRemaining", ОбщийГруп)
    ОтветБаланс.Вставить("items", Позиции)
    СериализацияJson.ЗаписатьОбъект(ПотокОтвета, ОтветБаланс)
;

метод ПолучитьГрупповыеРасписания(Запрос: HttpСервисЗапрос)
    знч ДатаСтрокой = Запрос.Параметры.ПолучитьПервый("date")

    знч Результат = Запрос{
        ВЫБРАТЬ
            Р.Ссылка КАК Ссылка,
            Р.Название КАК Название,
            Р.Корт КАК Корт,
            Р.Тренер КАК Тренер,
            Р.Дата КАК Дата,
            Р.Длительность КАК Длительность,
            Р.Цена КАК Цена
        ИЗ ГрупповоеРасписание КАК Р
    }.Выполнить()

    знч Список = новый Массив<Соответствие<Строка, Объект>>()
    для Строка из Результат
        пер Подходит = Истина
        если ДатаСтрокой != Неопределено
            Подходит = Строка.Дата.Представление("гггг-ММ-дд") == ДатаСтрокой
        ;
        если Подходит
            знч Элемент = новый Соответствие<Строка, Объект>()
            Элемент.Вставить("id", Строка.Ссылка.Ид.ВСтроку())
            Элемент.Вставить("title", Строка.Название)
            если Строка.Корт != Неопределено
                Элемент.Вставить("courtId", Строка.Корт.Ид.ВСтроку())
            ;
            если Строка.Тренер != Неопределено
                Элемент.Вставить("coachId", Строка.Тренер.Ид.ВСтроку())
            ;
            Элемент.Вставить("startAt", КСтрокеISO(Строка.Дата))
            Элемент.Вставить("durationMinutes", Строка.Длительность)
            Элемент.Вставить("price", Строка.Цена)
            Список.Добавить(Элемент)
        ;
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьДоступность(Запрос: HttpСервисЗапрос)
    знч ДатаСтрокой = Запрос.Параметры.ПолучитьПервый("date")
    знч КортИдСтрокой = Запрос.Параметры.ПолучитьПервый("courtId")
    знч ТренерИдСтрокой = Запрос.Параметры.ПолучитьПервый("coachId")

    знч Интервалы = новый Массив<Соответствие<Строка, Объект>>()

    если КортИдСтрокой != Неопределено
        знч КортСсылка = новый Корты.Ссылка(новый Ууид(КортИдСтрокой))
        знч ПоКорту = Запрос{
            ВЫБРАТЬ З.Дата КАК Дата, З.Длительность КАК Длительность
            ИЗ Занятие КАК З
            ГДЕ З.Отменено == Ложь И З.Корт == %КортСсылка
        }.Выполнить()
        для Строка из ПоКорту
            если Строка.Дата.Представление("гггг-ММ-дд") == ДатаСтрокой
                знч Элемент = новый Соответствие<Строка, Объект>()
                Элемент.Вставить("startAt", КСтрокеISO(Строка.Дата))
                Элемент.Вставить("endAt", КСтрокеISO(Строка.Дата.ДобавитьМинуты(Строка.Длительность)))
                Интервалы.Добавить(Элемент)
            ;
        ;
    ;

    если ТренерИдСтрокой != Неопределено
        знч ТренерСсылка = новый Тренеры.Ссылка(новый Ууид(ТренерИдСтрокой))
        знч ПоТренеру = Запрос{
            ВЫБРАТЬ З.Дата КАК Дата, З.Длительность КАК Длительность
            ИЗ Занятие КАК З
            ГДЕ З.Отменено == Ложь И З.Тренер == %ТренерСсылка
        }.Выполнить()
        для Строка из ПоТренеру
            если Строка.Дата.Представление("гггг-ММ-дд") == ДатаСтрокой
                знч Элемент = новый Соответствие<Строка, Объект>()
                Элемент.Вставить("startAt", КСтрокеISO(Строка.Дата))
                Элемент.Вставить("endAt", КСтрокеISO(Строка.Дата.ДобавитьМинуты(Строка.Длительность)))
                Интервалы.Добавить(Элемент)
            ;
        ;
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, Интервалы)
;

метод БронированиеВJson(Ссылка: Занятие.Ссылка, Формат: ФорматыЗанятий, Корт: Корты.Ссылка?, Тренер: Тренеры.Ссылка?, Дата: ДатаВремя, Длительность: Число, Цена: Число, Отменено: Булево): Соответствие<Строка, Объект>
    знч Элемент = новый Соответствие<Строка, Объект>()
    Элемент.Вставить("id", Ссылка.Ид.ВСтроку())
    если Отменено
        Элемент.Вставить("status", "CANCELLED")
    иначе
        Элемент.Вставить("status", "CONFIRMED")
    ;
    если Формат == ФорматыЗанятий.Групповое
        Элемент.Вставить("format", "GROUP")
    иначе
        Элемент.Вставить("format", "INDIVIDUAL")
    ;
    если Корт != Неопределено
        Элемент.Вставить("courtId", Корт.Ид.ВСтроку())
    ;
    если Тренер != Неопределено
        Элемент.Вставить("coachId", Тренер.Ид.ВСтроку())
    ;
    Элемент.Вставить("startAt", КСтрокеISO(Дата))
    Элемент.Вставить("endAt", КСтрокеISO(Дата.ДобавитьМинуты(Длительность)))
    Элемент.Вставить("price", Цена)
    возврат Элемент
;

метод ПолучитьБронирования(Запрос: HttpСервисЗапрос)
    знч КлиентИдСтрокой = Запрос.Параметры.ПолучитьПервый("clientId")
    если КлиентИдСтрокой == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан clientId")
        возврат
    ;
    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(КлиентИдСтрокой))

    знч Список = новый Массив<Соответствие<Строка, Объект>>()

    знч ИндЗапрос = Запрос{
        ВЫБРАТЬ
            З.Ссылка КАК Ссылка, З.Формат КАК Формат, З.Корт КАК Корт, З.Тренер КАК Тренер,
            З.Дата КАК Дата, З.Длительность КАК Длительность, З.Цена КАК Цена, З.Отменено КАК Отменено
        ИЗ Занятие КАК З
        ГДЕ З.Клиент == %КлиентСсылка
    }.Выполнить()
    для Строка из ИндЗапрос
        Список.Добавить(БронированиеВJson(Строка.Ссылка, Строка.Формат, Строка.Корт, Строка.Тренер, Строка.Дата, Строка.Длительность, Строка.Цена, Строка.Отменено))
    ;

    знч ГрупповыеЗапрос = Запрос{
        ВЫБРАТЬ З.Ссылка КАК Ссылка
        ИЗ Занятие КАК З
        ГДЕ З.Формат == ФорматыЗанятий.Групповое
    }.Выполнить()
    для СтрокаГр из ГрупповыеЗапрос
        знч ОбъектГр = СтрокаГр.Ссылка.ЗагрузитьОбъект()
        пер Найден = Ложь
        для УчастникСтрока из ОбъектГр.Участники
            если УчастникСтрока.Клиент == КлиентСсылка
                Найден = Истина
            ;
        ;
        если Найден
            Список.Добавить(БронированиеВJson(ОбъектГр.Ссылка, ОбъектГр.Формат, ОбъектГр.Корт, ОбъектГр.Тренер, ОбъектГр.Дата, ОбъектГр.Длительность, ОбъектГр.Цена, ОбъектГр.Отменено))
        ;
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ОтменитьБронирование(Запрос: HttpСервисЗапрос)
    знч ИдСтрокой = Запрос.Параметры.ПолучитьПервый("id")
    знч КлиентИдСтрокой = Запрос.Параметры.ПолучитьПервый("clientId")

    если КлиентИдСтрокой == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан clientId")
        возврат
    ;

    знч ЗанятиеСсылка = новый Занятие.Ссылка(новый Ууид(ИдСтрокой))
    знч ЗапросЗанятия = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка ИЗ Занятие КАК З ГДЕ З.Ссылка == %ЗанятиеСсылка}
    если ЗапросЗанятия.Выполнить().ПервыйИлиНеопределено() == Неопределено
        ОтветОшибка(Запрос, 404, "BOOKING_NOT_FOUND", "Бронирование не найдено")
        возврат
    ;

    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(КлиентИдСтрокой))
    знч ОбъектЗанятия = ЗанятиеСсылка.ЗагрузитьОбъект()

    если ОбъектЗанятия.Формат == ФорматыЗанятий.Индивидуальное
        если ОбъектЗанятия.Клиент != КлиентСсылка
            ОтветОшибка(Запрос, 404, "BOOKING_NOT_FOUND", "Бронирование не найдено")
            возврат
        ;
        если ОбъектЗанятия.Отменено
            ОтветОшибка(Запрос, 422, "BOOKING_CANNOT_BE_CANCELLED", "Бронирование уже отменено")
            возврат
        ;
        ОбъектЗанятия.Отменено = Истина
    иначе
        пер Найден = Ложь
        пер УдаляемаяСтрока: Занятие.Участники? = Неопределено
        пер ОстальныеКоличество = 0
        для Строка из ОбъектЗанятия.Участники
            если Строка.Клиент == КлиентСсылка
                Найден = Истина
                УдаляемаяСтрока = Строка
            иначе
                ОстальныеКоличество = ОстальныеКоличество + 1
            ;
        ;
        если не Найден
            ОтветОшибка(Запрос, 404, "BOOKING_NOT_FOUND", "Бронирование не найдено")
            возврат
        ;
        ОбъектЗанятия.Участники.Удалить(УдаляемаяСтрока)
        если ОстальныеКоличество == 0
            ОбъектЗанятия.Отменено = Истина
        ;
    ;

    попытка
        ОбъектЗанятия.Записать()
    поймать Ошибка: Исключение
        ОтветОшибка(Запрос, 500, "INTERNAL_ERROR", Ошибка.Описание)
        возврат
    ;

    Запрос.Ответ.УстановитьКодСтатуса(204)
;

структура БронированиеЗапрос
    пер clientId: Строка
    пер format: Строка
    пер courtId: Строка?
    пер coachId: Строка?
    пер startAt: ДатаВремя?
    пер durationMinutes: Число?
    пер groupSessionId: Строка?
;

метод СоздатьБронирование(Запрос: HttpСервисЗапрос)
    знч Данные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<БронированиеЗапрос>)

    если Данные.format == "GROUP"
        СоздатьГрупповоеБронирование(Запрос, Данные)
        возврат
    ;
    если Данные.format != "INDIVIDUAL"
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "format должен быть INDIVIDUAL или GROUP")
        возврат
    ;
    если Данные.courtId == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан courtId")
        возврат
    ;
    если Данные.startAt == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан startAt")
        возврат
    ;

    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(Данные.clientId))
    знч ЗапросКлиента = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка ИЗ Клиенты КАК К ГДЕ К.Ссылка == %КлиентСсылка}
    если ЗапросКлиента.Выполнить().ПервыйИлиНеопределено() == Неопределено
        ОтветОшибка(Запрос, 404, "CLIENT_NOT_FOUND", "Клиент не найден")
        возврат
    ;

    знч КортСсылка = новый Корты.Ссылка(новый Ууид(Данные.courtId))
    знч ЗапросКорта = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Кт.Ссылка ИЗ Корты КАК Кт ГДЕ Кт.Ссылка == %КортСсылка}
    если ЗапросКорта.Выполнить().ПервыйИлиНеопределено() == Неопределено
        ОтветОшибка(Запрос, 404, "COURT_NOT_FOUND", "Корт не найден")
        возврат
    ;

    пер ТренерСсылка: Тренеры.Ссылка? = Неопределено
    если Данные.coachId != Неопределено
        ТренерСсылка = новый Тренеры.Ссылка(новый Ууид(Данные.coachId))
        знч ЗапросТренера = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Т.Ссылка ИЗ Тренеры КАК Т ГДЕ Т.Ссылка == %ТренерСсылка}
        если ЗапросТренера.Выполнить().ПервыйИлиНеопределено() == Неопределено
            ОтветОшибка(Запрос, 404, "COACH_NOT_FOUND", "Тренер не найден")
            возврат
        ;
    ;

    знч НовоеЗанятие = новый Занятие.Объект()
    НовоеЗанятие.Формат = ФорматыЗанятий.Индивидуальное
    НовоеЗанятие.Клиент = КлиентСсылка
    НовоеЗанятие.Корт = КортСсылка
    НовоеЗанятие.Тренер = ТренерСсылка
    НовоеЗанятие.Дата = Данные.startAt
    если Данные.durationMinutes != Неопределено
        НовоеЗанятие.Количество = Данные.durationMinutes / 45
    ;

    попытка
        НовоеЗанятие.Записать()
    поймать Ошибка: Исключение
        ОтветОшибка(Запрос, 409, "BOOKING_SLOT_NOT_AVAILABLE", Ошибка.Описание)
        возврат
    ;

    Запрос.Ответ.УстановитьКодСтатуса(201)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч ПотокОтвета = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч ОтветДанные = новый Соответствие<Строка, Объект>()
    ОтветДанные.Вставить("id", НовоеЗанятие.Ссылка.Ид.ВСтроку())
    ОтветДанные.Вставить("status", "CONFIRMED")
    ОтветДанные.Вставить("format", "INDIVIDUAL")
    ОтветДанные.Вставить("courtId", Данные.courtId)
    если Данные.coachId != Неопределено
        ОтветДанные.Вставить("coachId", Данные.coachId)
    ;
    ОтветДанные.Вставить("startAt", КСтрокеISO(НовоеЗанятие.Дата))
    ОтветДанные.Вставить("endAt", КСтрокеISO(НовоеЗанятие.Дата.ДобавитьМинуты(НовоеЗанятие.Длительность)))
    ОтветДанные.Вставить("price", НовоеЗанятие.Цена)
    СериализацияJson.ЗаписатьОбъект(ПотокОтвета, ОтветДанные)
;

// Групповая бронь не создаёт новый Занятие - он уже есть (автосоздан при создании ГрупповоеРасписание),
// здесь просто добавляем участника в его табличную часть Участники.
метод СоздатьГрупповоеБронирование(Запрос: HttpСервисЗапрос, Данные: БронированиеЗапрос)
    если Данные.groupSessionId == Неопределено
        ОтветОшибка(Запрос, 400, "VALIDATION_ERROR", "Не указан groupSessionId")
        возврат
    ;

    знч РасписаниеСсылка = новый ГрупповоеРасписание.Ссылка(новый Ууид(Данные.groupSessionId))
    знч ЗапросЗанятия = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 З.Ссылка КАК Ссылка
        ИЗ Занятие КАК З
        ГДЕ З.Расписание == %РасписаниеСсылка
    }
    знч СтрокаЗанятия = ЗапросЗанятия.Выполнить().ПервыйИлиНеопределено()
    если СтрокаЗанятия == Неопределено
        ОтветОшибка(Запрос, 404, "GROUP_SESSION_NOT_FOUND", "Групповое занятие не найдено")
        возврат
    ;

    знч КлиентСсылка = новый Клиенты.Ссылка(новый Ууид(Данные.clientId))
    знч ЗапросКлиента = Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка ИЗ Клиенты КАК К ГДЕ К.Ссылка == %КлиентСсылка}
    если ЗапросКлиента.Выполнить().ПервыйИлиНеопределено() == Неопределено
        ОтветОшибка(Запрос, 404, "CLIENT_NOT_FOUND", "Клиент не найден")
        возврат
    ;

    знч ОбъектЗанятия = СтрокаЗанятия.Ссылка.ЗагрузитьОбъект()

    для Строка из ОбъектЗанятия.Участники
        если Строка.Клиент == КлиентСсылка
            ОтветОшибка(Запрос, 409, "ALREADY_BOOKED", "Клиент уже записан на это занятие")
            возврат
        ;
    ;

    знч НоваяСтрока = новый Занятие.Участники(Клиент = КлиентСсылка, ПоАбонементу = Ложь)
    ОбъектЗанятия.Участники.Добавить(НоваяСтрока)

    попытка
        ОбъектЗанятия.Записать()
    поймать Ошибка: Исключение
        ОтветОшибка(Запрос, 500, "INTERNAL_ERROR", Ошибка.Описание)
        возврат
    ;

    Запрос.Ответ.УстановитьКодСтатуса(201)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч ПотокГруппы = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч ОтветГруппы = новый Соответствие<Строка, Объект>()
    ОтветГруппы.Вставить("id", ОбъектЗанятия.Ссылка.Ид.ВСтроку())
    ОтветГруппы.Вставить("status", "CONFIRMED")
    ОтветГруппы.Вставить("format", "GROUP")
    если ОбъектЗанятия.Корт != Неопределено
        ОтветГруппы.Вставить("courtId", ОбъектЗанятия.Корт.Ид.ВСтроку())
    ;
    если ОбъектЗанятия.Тренер != Неопределено
        ОтветГруппы.Вставить("coachId", ОбъектЗанятия.Тренер.Ид.ВСтроку())
    ;
    ОтветГруппы.Вставить("startAt", КСтрокеISO(ОбъектЗанятия.Дата))
    ОтветГруппы.Вставить("endAt", КСтрокеISO(ОбъектЗанятия.Дата.ДобавитьМинуты(ОбъектЗанятия.Длительность)))
    ОтветГруппы.Вставить("price", ОбъектЗанятия.Цена)
    СериализацияJson.ЗаписатьОбъект(ПотокГруппы, ОтветГруппы)
;

структура КлиентЗапрос
    пер externalId: Строка
    пер fullName: Строка
;

метод СоздатьКлиента(Запрос: HttpСервисЗапрос)
    знч Данные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<КлиентЗапрос>)

    знч ВнешнийИдЗначение = Данные.externalId
    знч ЗапросПоиска = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка
        ИЗ Клиенты КАК К
        ГДЕ К.ВнешнийИд == %ВнешнийИдЗначение
    }
    знч СтрокаПоиска = ЗапросПоиска.Выполнить().ПервыйИлиНеопределено()

    пер КлиентСсылка: Клиенты.Ссылка? = Неопределено
    если СтрокаПоиска != Неопределено
        КлиентСсылка = СтрокаПоиска.Ссылка
    иначе
        знч НовыйКлиент = новый Клиенты.Объект()
        НовыйКлиент.Наименование = Данные.fullName
        НовыйКлиент.ВнешнийИд = Данные.externalId
        НовыйКлиент.Записать()
        КлиентСсылка = НовыйКлиент.Ссылка
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, {"id": КлиентСсылка?.Ид.ВСтроку()})
;

метод ПолучитьКлиентов(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            К.Ссылка КАК Ссылка,
            К.Наименование КАК Наименование,
            К.Телефон КАК Телефон,
            К.ВнешнийИд КАК ВнешнийИд
        ИЗ Клиенты КАК К
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Объект>>()
    для Строка из Результат
        знч Элемент = новый Соответствие<Строка, Объект>()
        Элемент.Вставить("id", Строка.Ссылка.Ид.ВСтроку())
        Элемент.Вставить("fullName", Строка.Наименование)
        Элемент.Вставить("externalId", Строка.ВнешнийИд)
        Список.Добавить(Элемент)
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьКлиента(Запрос: HttpСервисЗапрос)
    знч ИдСтрокой = Запрос.Параметры.ПолучитьПервый("id")
    знч Ссылка = новый Клиенты.Ссылка(новый Ууид(ИдСтрокой))

    знч ЗапросПроверки = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            К.Ссылка КАК Ссылка,
            К.Наименование КАК Наименование,
            К.Телефон КАК Телефон,
            К.ВнешнийИд КАК ВнешнийИд
        ИЗ Клиенты КАК К
        ГДЕ К.Ссылка == %Ссылка
    }
    знч Строка = ЗапросПроверки.Выполнить().ПервыйИлиНеопределено()
    если Строка == Неопределено
        ОтветОшибка(Запрос, 404, "CLIENT_NOT_FOUND", "Клиент не найден")
        возврат
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Ответ = новый Соответствие<Строка, Объект>()
    Ответ.Вставить("id", Строка.Ссылка.Ид.ВСтроку())
    Ответ.Вставить("fullName", Строка.Наименование)
    Ответ.Вставить("externalId", Строка.ВнешнийИд)
    СериализацияJson.ЗаписатьОбъект(Поток, Ответ)
;

метод ПолучитьКорты(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            К.Ссылка КАК Ссылка,
            К.Наименование КАК Наименование,
            К.ТипПокрытия КАК ТипПокрытия
        ИЗ Корты КАК К
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Строка>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "name": Строка.Наименование,
            "type": Строка.ТипПокрытия
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьТренеров(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            Т.Ссылка КАК Ссылка,
            Т.Наименование КАК Наименование,
            Т.Специализация КАК Специализация
        ИЗ Тренеры КАК Т
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Строка>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "fullName": Строка.Наименование,
            "specialization": Строка.Специализация
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьТипыАбонементов(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            Т.Ссылка КАК Ссылка,
            Т.Наименование КАК Наименование,
            Т.КоличествоИндивидуальных КАК КоличествоИндивидуальных,
            Т.КоличествоГрупповых КАК КоличествоГрупповых,
            Т.СрокДействияДней КАК СрокДействияДней,
            Т.Цена КАК Цена
        ИЗ ТипыАбонементов КАК Т
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Объект>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "name": Строка.Наименование,
            "individualSessions": Строка.КоличествоИндивидуальных,
            "groupSessions": Строка.КоличествоГрупповых,
            "validDays": Строка.СрокДействияДней,
            "price": Строка.Цена
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;
