импорт НСИ

структура КлиентЗапрос
    пер externalId: Строка
    пер fullName: Строка
;

метод СоздатьКлиента(Запрос: HttpСервисЗапрос)
    знч Данные = СериализацияJson.ПрочитатьОбъект(Запрос.Тело, Тип<КлиентЗапрос>) как КлиентЗапрос

    знч ВнешнийИдЗначение = Данные.externalId
    знч ЗапросПоиска = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 К.Ссылка КАК Ссылка
        ИЗ Клиенты КАК К
        ГДЕ К.ВнешнийИд == %ВнешнийИдЗначение
    }
    знч СтрокаПоиска = ЗапросПоиска.Выполнить().ПервыйИлиНеопределено()

    пер КлиентСсылка: Клиенты.Ссылка? = Неопределено
    если СтрокаПоиска != Неопределено
        КлиентСсылка = СтрокаПоиска.Ссылка
    иначе
        знч НовыйКлиент = новый Клиенты.Объект()
        НовыйКлиент.Наименование = Данные.fullName
        НовыйКлиент.ВнешнийИд = Данные.externalId
        НовыйКлиент.Записать()
        КлиентСсылка = НовыйКлиент.Ссылка
    ;

    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    СериализацияJson.ЗаписатьОбъект(Поток, {"id": КлиентСсылка?.Ид.ВСтроку()})
;

метод ПолучитьКорты(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            К.Ссылка КАК Ссылка,
            К.Наименование КАК Наименование,
            К.ТипПокрытия КАК ТипПокрытия
        ИЗ Корты КАК К
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Строка>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "name": Строка.Наименование,
            "type": Строка.ТипПокрытия
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьТренеров(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            Т.Ссылка КАК Ссылка,
            Т.Наименование КАК Наименование,
            Т.Специализация КАК Специализация
        ИЗ Тренеры КАК Т
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Строка>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "fullName": Строка.Наименование,
            "specialization": Строка.Специализация
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;

метод ПолучитьТипыАбонементов(Запрос: HttpСервисЗапрос)
    Запрос.Ответ.Заголовки.Установить("Content-Type", "application/json")
    знч Поток = Запрос.Ответ.ОткрытьПотокЗаписиТела()
    знч Результат = Запрос{
        ВЫБРАТЬ
            Т.Ссылка КАК Ссылка,
            Т.Наименование КАК Наименование,
            Т.КоличествоИндивидуальных КАК КоличествоИндивидуальных,
            Т.КоличествоГрупповых КАК КоличествоГрупповых,
            Т.СрокДействияДней КАК СрокДействияДней,
            Т.Цена КАК Цена
        ИЗ ТипыАбонементов КАК Т
    }.Выполнить()
    знч Список = новый Массив<Соответствие<Строка, Объект>>()
    для Строка из Результат
        Список.Добавить({
            "id": Строка.Ссылка.Ид.ВСтроку(),
            "name": Строка.Наименование,
            "individualSessions": Строка.КоличествоИндивидуальных,
            "groupSessions": Строка.КоличествоГрупповых,
            "validDays": Строка.СрокДействияДней,
            "price": Строка.Цена
        })
    ;
    СериализацияJson.ЗаписатьОбъект(Поток, Список)
;
