импорт НСИ

@Обработчик
метод ПередЗаписью(До: ПродажаАбонемента.Данные, ПараметрыЗаписи: ПродажаАбонемента.ПараметрыЗаписи)
    если Клиент == Неопределено
        выбросить новый ИсключениеНедопустимоеСостояние(Описание = "Укажите клиента")
    ;
    если ТипАбонемента == Неопределено
        выбросить новый ИсключениеНедопустимоеСостояние(Описание = "Укажите тип абонемента")
    ;
    если Цена <= 0
        знч ЗапросТипа = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Т.Цена КАК Цена
            ИЗ ТипыАбонементов КАК Т
            ГДЕ Т.Ссылка == %ТипАбонемента
        }
        знч ДанныеТипа = ЗапросТипа.Выполнить().ПервыйИлиНеопределено()
        если ДанныеТипа != Неопределено
            Цена = ДанныеТипа.Цена
        ;
    ;
;

@Обработчик
метод ПослеЗаписи(До: ПродажаАбонемента.Данные, ПараметрыЗаписи: ПродажаАбонемента.ПараметрыЗаписи)
    знч ЗапросТипа = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Т.КоличествоИндивидуальных КАК КоличествоИндивидуальных,
            Т.КоличествоГрупповых КАК КоличествоГрупповых
        ИЗ ТипыАбонементов КАК Т
        ГДЕ Т.Ссылка == %ТипАбонемента
    }
    знч ДанныеТипа = ЗапросТипа.Выполнить().ПервыйИлиНеопределено()

    знч ДвиженияОстатков = новый ОстаткиАбонементов.НаборЗаписей()
    ДвиженияОстатков.Фильтр.Установить(Регистратор = Ссылка)

    если ДанныеТипа != Неопределено
        если ДанныеТипа.КоличествоИндивидуальных > 0
            ДвиженияОстатков.ДобавитьЗапись(
                Период = Дата,
                ВидЗаписи = ВидЗаписиРегистраНакопления.Приход,
                Клиент = Клиент,
                Абонемент = Ссылка,
                ТипПула = ТипыПулаЗанятий.Индивидуальные,
                КоличествоЗанятий = ДанныеТипа.КоличествоИндивидуальных
            )
        ;
        если ДанныеТипа.КоличествоГрупповых > 0
            ДвиженияОстатков.ДобавитьЗапись(
                Период = Дата,
                ВидЗаписи = ВидЗаписиРегистраНакопления.Приход,
                Клиент = Клиент,
                Абонемент = Ссылка,
                ТипПула = ТипыПулаЗанятий.Групповые,
                КоличествоЗанятий = ДанныеТипа.КоличествоГрупповых
            )
        ;
    ;
    ДвиженияОстатков.Записать()

    знч ДвиженияВыручки = новый Выручка.НаборЗаписей()
    ДвиженияВыручки.Фильтр.Установить(Регистратор = Ссылка)
    ДвиженияВыручки.ДобавитьЗапись(
        Период = Дата,
        Клиент = Клиент,
        Сумма = Цена
    )
    ДвиженияВыручки.Записать()
;
