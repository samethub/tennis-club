// FIFO-списание занятий с абонементов клиента: сначала те, что раньше истекают.
// Возвращает массив лотов {Абонемент, Количество} или Неопределено, если занятий не хватило
// (в этом случае ничего не списывается - вызывающий код должен списать деньгами).
@ВПроекте
метод СписатьСАбонемента(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, КоличествоКСписанию: Число, ДатаЗанятия: ДатаВремя): Массив<Структура>?
    знч Граница = новый Граница(МоментВремени(), ВидГраницы.Исключая)
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Остатки.Абонемент КАК Абонемент,
            Остатки.КоличествоЗанятийОстаток КАК Остаток,
            ДОБАВИТЬКДАТЕ(Остатки.Абонемент.Дата, ДЕНЬ, Остатки.Абонемент.ТипАбонемента.СрокДействияДней) КАК ДатаОкончания
        ИЗ ОстаткиАбонементов.Остатки(%Граница, Клиент = %Клиент И ТипПула = %ТипПула) КАК Остатки
        ГДЕ Остатки.КоличествоЗанятийОстаток > 0
        УПОРЯДОЧИТЬ ПО ДатаОкончания
    }
    знч Строки = Запрос.Выполнить().ВМассив()

    пер ОсталосьСписать = КоличествоКСписанию
    пер Лоты: Массив<Структура> = []
    для Строка из Строки
        если ОсталосьСписать <= 0
            прервать
        ;
        если Строка.ДатаОкончания >= ДатаЗанятия
            пер КСписанию = Строка.Остаток
            если КСписанию > ОсталосьСписать
                КСписанию = ОсталосьСписать
            ;
            Лоты.Добавить(новый Структура(Абонемент = Строка.Абонемент, Количество = КСписанию))
            ОсталосьСписать = ОсталосьСписать - КСписанию
        ;
    ;

    если ОсталосьСписать > 0
        возврат Неопределено
    ;
    возврат Лоты
;
