импорт НСИ

// Проверяет, хватает ли клиенту занятий в активных абонементах, без списания (для предварительной проверки).
@ВПроекте
метод ХватаетНаАбонементе(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, Количество: Число, ДатаЗанятия: ДатаВремя): Булево
    возврат СписатьСАбонемента(Клиент, ТипПула, Количество, ДатаЗанятия, Неопределено)
;

// FIFO-списание занятий с абонементов клиента: сначала купленные раньше (приближение к "раньше истекают" -
// верно, когда у типов абонементов сопоставимый срок действия).
// Если передан Движения - реально добавляет расходные записи в него; если Неопределено - только проверяет.
// Возвращает Истина, если количества хватило полностью (частичное списание не делается).
@ВПроекте
метод СписатьСАбонемента(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, КоличествоКСписанию: Число, ДатаЗанятия: ДатаВремя, Движения: ОстаткиАбонементов.НаборЗаписей?): Булево
    знч Запрос = Запрос{
        ВЫБРАТЬ
            Остатки.Абонемент КАК Абонемент,
            Остатки.КоличествоЗанятийОстаток КАК Остаток,
            Остатки.Абонемент.Дата КАК ДатаПокупки,
            Остатки.Абонемент.ТипАбонемента.СрокДействияДней КАК СрокДействияДней
        ИЗ ОстаткиАбонементов.Остатки КАК Остатки
        ГДЕ Остатки.Клиент == %Клиент
            И Остатки.ТипПула == %ТипПула
            И Остатки.КоличествоЗанятийОстаток > 0
        УПОРЯДОЧИТЬ ПО Остатки.Абонемент.Дата
    }
    знч Строки = Запрос.Выполнить().ВМассив()

    пер ОсталосьСписать = КоличествоКСписанию
    для Строка из Строки
        если ОсталосьСписать <= 0
            прервать
        ;
        знч ДатаОкончания = Строка.ДатаПокупки.ДобавитьДни(Строка.СрокДействияДней)
        если ДатаОкончания >= ДатаЗанятия
            пер КСписанию = Строка.Остаток
            если КСписанию > ОсталосьСписать
                КСписанию = ОсталосьСписать
            ;
            если Движения != Неопределено
                Движения.ДобавитьЗапись(
                    Период = ДатаЗанятия,
                    ВидЗаписи = ВидЗаписиРегистраНакопления.Расход,
                    Клиент = Клиент,
                    Абонемент = Строка.Абонемент,
                    ТипПула = ТипПула,
                    КоличествоЗанятий = КСписанию
                )
            ;
            ОсталосьСписать = ОсталосьСписать - КСписанию
        ;
    ;

    возврат ОсталосьСписать <= 0
;
