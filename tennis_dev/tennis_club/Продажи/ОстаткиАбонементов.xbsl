импорт НСИ
импорт Продажи

// Проверяет, хватает ли клиенту занятий в активных абонементах, без списания (для предварительной проверки).
@ВПроекте
метод ХватаетНаАбонементе(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, Количество: Число, ДатаЗанятия: ДатаВремя): Булево
    возврат СписатьСАбонемента(Клиент, ТипПула, Количество, ДатаЗанятия, Неопределено)
;

// Списание занятий с абонементов клиента. Если передан Движения - реально добавляет расходные записи
// в него; если Неопределено - только проверяет. Возвращает Истина, если количества хватило полностью
// (частичное списание не делается).
// ВРЕМЕННО: без строгого FIFO по дате истечения (см. комментарий ниже у ДанныеАбонемента) - лоты
// обрабатываются в порядке, в котором их отдаёт регистр, а не строго "раньше всех истекает - первый".
@ВПроекте
метод СписатьСАбонемента(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, КоличествоКСписанию: Число, ДатаЗанятия: ДатаВремя, Движения: ОстаткиАбонементов.НаборЗаписей?): Булево
    знч ЗапросОстатков = Запрос{
        ВЫБРАТЬ
            Остатки.Абонемент КАК Абонемент,
            Остатки.КоличествоЗанятийОстаток КАК Остаток
        ИЗ ОстаткиАбонементов.Остатки КАК Остатки
        ГДЕ Остатки.Клиент == %Клиент
            И Остатки.ТипПула == %ТипПула
            И Остатки.КоличествоЗанятийОстаток > 0
    }
    знч Лоты = ЗапросОстатков.Выполнить().ВМассив()

    пер ОсталосьСписать = КоличествоКСписанию
    для Лот из Лоты
        если ОсталосьСписать <= 0
            прервать
        ;

        // Поле через навигацию на 2 уровня (Остатки.Абонемент.Дата) типизируется как Объект, а не
        // ДатаВремя, поэтому читаем дату и тип абонемента отдельным простым запросом по самой ссылке.
        знч АбонементСсылка = Лот.Абонемент
        знч ЗапросАбонемента = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 А.Дата КАК Дата, А.ТипАбонемента КАК ТипАбонемента
            ИЗ ПродажаАбонемента КАК А
            ГДЕ А.Ссылка == %АбонементСсылка
        }
        знч ДанныеАбонемента = ЗапросАбонемента.Выполнить().ПервыйИлиНеопределено()

        если ДанныеАбонемента != Неопределено
            знч ТипСсылка = ДанныеАбонемента.ТипАбонемента
            знч ЗапросТипа = Запрос{
                ВЫБРАТЬ ПЕРВЫЕ 1 Т.СрокДействияДней КАК СрокДействияДней
                ИЗ ТипыАбонементов КАК Т
                ГДЕ Т.Ссылка == %ТипСсылка
            }
            знч ДанныеТипа = ЗапросТипа.Выполнить().ПервыйИлиНеопределено()

            если ДанныеТипа != Неопределено
                знч ДатаОкончания = ДанныеАбонемента.Дата.ДобавитьДни(ДанныеТипа.СрокДействияДней)
                если ДатаОкончания >= ДатаЗанятия
                    пер КСписанию = Лот.Остаток
                    если КСписанию > ОсталосьСписать
                        КСписанию = ОсталосьСписать
                    ;
                    если Движения != Неопределено
                        Движения.ДобавитьЗапись(
                            Период = ДатаЗанятия,
                            ВидЗаписи = ВидЗаписиРегистраНакопления.Расход,
                            Клиент = Клиент,
                            Абонемент = Лот.Абонемент,
                            ТипПула = ТипПула,
                            КоличествоЗанятий = КСписанию
                        )
                    ;
                    ОсталосьСписать = ОсталосьСписать - КСписанию
                ;
            ;
        ;
    ;

    возврат ОсталосьСписать <= 0
;
