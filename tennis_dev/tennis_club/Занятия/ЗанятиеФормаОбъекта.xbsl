импорт НСИ

метод РасписаниеПриИзменении(Источник: ПолеВвода<ГрупповоеРасписание.Ссылка?>, Событие: СобытиеПриИзменении<ГрупповоеРасписание.Ссылка?>)
    знч Ссылка = Событие.НовоеЗначение
    если Ссылка != Неопределено
        Объект.Дата = ПолучитьДатуРасписания(Ссылка)
        Объект.Корт = ПолучитьКортРасписания(Ссылка)
        Объект.Тренер = ПолучитьТренераРасписания(Ссылка)
        Объект.Длительность = ПолучитьДлительностьРасписания(Ссылка)
        Объект.Цена = ПолучитьЦенуРасписания(Ссылка)
    ;
;

метод КоличествоПриИзменении(Источник: ПолеВвода<Число>, Событие: СобытиеПриИзменении<Число>)
    если Объект.Формат == ФорматыЗанятий.Индивидуальное
        знч НовоеКоличество = Событие.НовоеЗначение
        если НовоеКоличество > 0
            Объект.Длительность = НовоеКоличество * 45
            Объект.Цена = ПолучитьЦенуИндивидуального() * НовоеКоличество
        ;
    ;
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьДатуРасписания(Ссылка: ГрупповоеРасписание.Ссылка?): ДатаВремя?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Р.Дата КАК Значение
        ИЗ ГрупповоеРасписание КАК Р
        ГДЕ Р.Ссылка == %Ссылка
    }
    возврат Запрос.Выполнить().ВМассив().ПервыйИлиНеопределено()?.Значение
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьКортРасписания(Ссылка: ГрупповоеРасписание.Ссылка?): Корты.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Р.Корт КАК Значение
        ИЗ ГрупповоеРасписание КАК Р
        ГДЕ Р.Ссылка == %Ссылка
    }
    возврат Запрос.Выполнить().ВМассив().ПервыйИлиНеопределено()?.Значение
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьТренераРасписания(Ссылка: ГрупповоеРасписание.Ссылка?): Тренеры.Ссылка?
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Р.Тренер КАК Значение
        ИЗ ГрупповоеРасписание КАК Р
        ГДЕ Р.Ссылка == %Ссылка
    }
    возврат Запрос.Выполнить().ВМассив().ПервыйИлиНеопределено()?.Значение
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьДлительностьРасписания(Ссылка: ГрупповоеРасписание.Ссылка?): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Р.Длительность КАК Значение
        ИЗ ГрупповоеРасписание КАК Р
        ГДЕ Р.Ссылка == %Ссылка
    }
    знч Строка = Запрос.Выполнить().ВМассив().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 60
    ;
    возврат Строка.Значение
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьЦенуРасписания(Ссылка: ГрупповоеРасписание.Ссылка?): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Р.Цена КАК Значение
        ИЗ ГрупповоеРасписание КАК Р
        ГДЕ Р.Ссылка == %Ссылка
    }
    знч Строка = Запрос.Выполнить().ВМассив().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 0
    ;
    возврат Строка.Значение
;

@НаСервере @ДоступноСКлиента
статический метод ПолучитьЦенуИндивидуального(): Число
    знч Запрос = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1 Н.ЦенаИндивидуальногоЗанятия КАК Значение
        ИЗ НастройкиКлуба КАК Н
    }
    знч Строка = Запрос.Выполнить().ВМассив().ПервыйИлиНеопределено()
    если Строка == Неопределено
        возврат 0
    ;
    возврат Строка.Значение
;
