импорт НСИ

@Обработчик
метод ПриЗаполнении(ТекстЗаполнения: Строка)
    если Длительность <= 0
        Длительность = 60
    ;
    если Цена <= 0
        знч ЗапросНастроек = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Н.ЦенаГрупповогоЗанятия КАК Цена
            ИЗ НастройкиКлуба КАК Н
        }
        знч Настройки = ЗапросНастроек.Выполнить().ПервыйИлиНеопределено()
        Цена = Настройки?.Цена
    ;
;

@Обработчик
метод ПередЗаписью(До: ГрупповоеРасписание.Данные, ПараметрыЗаписи: ГрупповоеРасписание.ПараметрыЗаписи)
    если Длительность <= 0
        Длительность = 60
    ;
    если Цена <= 0
        знч ЗапросНастроек = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Н.ЦенаГрупповогоЗанятия КАК Цена
            ИЗ НастройкиКлуба КАК Н
        }
        знч Настройки = ЗапросНастроек.Выполнить().ПервыйИлиНеопределено()
        Цена = Настройки?.Цена
    ;
;

@Обработчик
метод ПослеЗаписи(До: ГрупповоеРасписание.Данные, ПараметрыЗаписи: ГрупповоеРасписание.ПараметрыЗаписи)
    если До.Ссылка == Неопределено
        СоздатьЗанятие()
    ;
;

// При первом создании расписания сразу заводим под него Занятие (формат Групповое),
// чтобы администратору оставалось только открыть его и добавить участников.
метод СоздатьЗанятие()
    знч НовоеЗанятие = новый Занятие.Объект()
    НовоеЗанятие.Дата = Дата
    НовоеЗанятие.Формат = ФорматыЗанятий.Групповое
    НовоеЗанятие.Корт = Корт
    НовоеЗанятие.Тренер = Тренер
    НовоеЗанятие.Длительность = Длительность
    НовоеЗанятие.Цена = Цена
    НовоеЗанятие.Расписание = Ссылка
    НовоеЗанятие.Записать()
;
