импорт НСИ
импорт Продажи

@Обработчик
метод ПередЗаписью(До: Занятие.Данные, ПараметрыЗаписи: Занятие.ПараметрыЗаписи)
    если Отменено
        возврат
    ;

    знч ЗапросНастроек = Запрос{
        ВЫБРАТЬ ПЕРВЫЕ 1
            Н.ЦенаИндивидуальногоЗанятия КАК ЦенаИндивидуального,
            Н.ЦенаГрупповогоЗанятия КАК ЦенаГруппового
        ИЗ НастройкиКлуба КАК Н
    }
    знч Настройки = ЗапросНастроек.Выполнить().ПервыйИлиНеопределено()

    если Формат == ФорматыЗанятий.Групповое
        если Расписание != Неопределено
            знч ЗапросРасписания = Запрос{
                ВЫБРАТЬ ПЕРВЫЕ 1
                    Р.Корт КАК Корт,
                    Р.Тренер КАК Тренер,
                    Р.Длительность КАК Длительность,
                    Р.Цена КАК Цена
                ИЗ ГрупповоеРасписание КАК Р
                ГДЕ Р.Ссылка == %Расписание
            }
            знч ДанныеРасписания = ЗапросРасписания.Выполнить().ПервыйИлиНеопределено()
            если ДанныеРасписания != Неопределено
                Корт = ДанныеРасписания.Корт
                Тренер = ДанныеРасписания.Тренер
                Длительность = ДанныеРасписания.Длительность
                Цена = ДанныеРасписания.Цена
            ;
        ;
        если Длительность <= 0
            Длительность = 60
        ;
        если Цена <= 0
            Цена = Настройки?.ЦенаГруппового
        ;
        Количество = 1
    иначе
        если Длительность <= 0
            Длительность = 45
        ;
        Количество = Длительность / 45
        если Цена <= 0
            Цена = Настройки?.ЦенаИндивидуального * Количество
        ;
    ;

    знч ДатаОкончания = Дата.ДобавитьМинуты(Длительность)

    если Корт != Неопределено
        знч ЗапросКорта = Запрос{
            ВЫБРАТЬ Занятие.Дата КАК Дата, Занятие.Длительность КАК Длительность
            ИЗ Занятие КАК Занятие
            ГДЕ Занятие.Корт == %Корт
                И Занятие.Отменено == Ложь
                И Занятие.Ссылка != %Ссылка
                И Занятие.Дата < %ДатаОкончания
        }
        для Строка из ЗапросКорта.Выполнить().ВМассив()
            если Строка.Дата.ДобавитьМинуты(Строка.Длительность) > Дата
                выбросить новый ИсключениеНедопустимоеСостояние(Описание = "Корт уже занят в это время")
            ;
        ;
    ;

    если Тренер != Неопределено
        знч ЗапросТренера = Запрос{
            ВЫБРАТЬ Занятие.Дата КАК Дата, Занятие.Длительность КАК Длительность
            ИЗ Занятие КАК Занятие
            ГДЕ Занятие.Тренер == %Тренер
                И Занятие.Отменено == Ложь
                И Занятие.Ссылка != %Ссылка
                И Занятие.Дата < %ДатаОкончания
        }
        для Строка из ЗапросТренера.Выполнить().ВМассив()
            если Строка.Дата.ДобавитьМинуты(Строка.Длительность) > Дата
                выбросить новый ИсключениеНедопустимоеСостояние(Описание = "Тренер уже занят в это время")
            ;
        ;
    ;

    // Предварительная проверка "хватит ли абонемента" - реальное списание происходит в ПослеЗаписи
    если Формат == ФорматыЗанятий.Групповое
        для Строка из Участники
            Строка.ПоАбонементу = ОстаткиАбонементов.ХватаетНаАбонементе(Строка.Клиент, ТипыПулаЗанятий.Групповые, Количество, Дата)
        ;
    иначе
        ПоАбонементу = ОстаткиАбонементов.ХватаетНаАбонементе(Клиент, ТипыПулаЗанятий.Индивидуальные, Количество, Дата)
    ;
;

@Обработчик
метод ПослеЗаписи(До: Занятие.Данные, ПараметрыЗаписи: Занятие.ПараметрыЗаписи)
    знч ДвиженияОстатков = новый ОстаткиАбонементов.НаборЗаписей()
    ДвиженияОстатков.Фильтр.Установить(Регистратор = Ссылка)

    знч ДвиженияВыручки = новый Выручка.НаборЗаписей()
    ДвиженияВыручки.Фильтр.Установить(Регистратор = Ссылка)

    если не Отменено
        если Формат == ФорматыЗанятий.Групповое
            для Строка из Участники
                ОтразитьОплатуКлиента(Строка.Клиент, ТипыПулаЗанятий.Групповые, ДвиженияОстатков, ДвиженияВыручки)
            ;
        иначе
            ОтразитьОплатуКлиента(Клиент, ТипыПулаЗанятий.Индивидуальные, ДвиженияОстатков, ДвиженияВыручки)
        ;
    ;

    ДвиженияОстатков.Записать()
    ДвиженияВыручки.Записать()
;

// Списывает с абонемента клиента нужное число занятий (Количество документа); если не хватило -
// проводит оплату деньгами на всю сумму (частичное списание не делается).
метод ОтразитьОплатуКлиента(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, ДвиженияОстатков: ОстаткиАбонементов.НаборЗаписей, ДвиженияВыручки: Выручка.НаборЗаписей)
    если ОстаткиАбонементов.ХватаетНаАбонементе(Клиент, ТипПула, Количество, Дата)
        ОстаткиАбонементов.СписатьСАбонемента(Клиент, ТипПула, Количество, Дата, ДвиженияОстатков)
    иначе
        ДвиженияВыручки.ДобавитьЗапись(
            Период = Дата,
            Клиент = Клиент,
            Сумма = Цена
        )
    ;
;
