@Обработчик
метод ПередЗаписью(До: Занятие.Данные, ПараметрыЗаписи: Занятие.ПараметрыЗаписи)
    если Отменено
        возврат
    ;

    если Формат == ФорматыЗанятий.Групповое
        если ЗначениеЗаполнено(ГрупповоеРасписание)
            Корт = ГрупповоеРасписание.Корт
            Тренер = ГрупповоеРасписание.Тренер
            Длительность = ГрупповоеРасписание.Длительность
            Цена = ГрупповоеРасписание.Цена
        иначе
            если Длительность <= 0
                Длительность = 60
            ;
            Цена = НастройкиКлуба.ЦенаГрупповогоЗанятия
        ;
        Количество = 1
    иначе
        если Длительность <= 0
            Длительность = 45
        ;
        Количество = Длительность / 45
        Цена = НастройкиКлуба.ЦенаИндивидуальногоЗанятия * Количество
    ;

    знч ТекущаяСсылка = Ссылка
    знч ДатаОкончания = ДОБАВИТЬКДАТЕ(Дата, МИНУТА, Длительность)

    если ЗначениеЗаполнено(Корт)
        знч Корт = Корт
        знч Дата = Дата
        знч ПересечениеКорта = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Занятие.Ссылка
            ИЗ Занятие КАК Занятие
            ГДЕ Занятие.Корт == %Корт
                И Занятие.Отменено == Ложь
                И Занятие.Ссылка != %ТекущаяСсылка
                И Занятие.Дата < %ДатаОкончания
                И ДОБАВИТЬКДАТЕ(Занятие.Дата, МИНУТА, Занятие.Длительность) > %Дата
        }
        если ПересечениеКорта.Выполнить().ПервыйИлиНеопределено() != Неопределено
            Сообщить("Корт уже занят в это время")
            ПараметрыЗаписи.Отказ = Истина
            возврат
        ;
    ;

    если ЗначениеЗаполнено(Тренер)
        знч Тренер = Тренер
        знч Дата = Дата
        знч ПересечениеТренера = Запрос{
            ВЫБРАТЬ ПЕРВЫЕ 1 Занятие.Ссылка
            ИЗ Занятие КАК Занятие
            ГДЕ Занятие.Тренер == %Тренер
                И Занятие.Отменено == Ложь
                И Занятие.Ссылка != %ТекущаяСсылка
                И Занятие.Дата < %ДатаОкончания
                И ДОБАВИТЬКДАТЕ(Занятие.Дата, МИНУТА, Занятие.Длительность) > %Дата
        }
        если ПересечениеТренера.Выполнить().ПервыйИлиНеопределено() != Неопределено
            Сообщить("Тренер уже занят в это время")
            ПараметрыЗаписи.Отказ = Истина
            возврат
        ;
    ;

    // Предварительный расчёт флага "оплачено абонементом" - только чтение остатков,
    // реальное списание происходит в ПослеЗаписи
    если Формат == ФорматыЗанятий.Групповое
        для Строка из Участники
            Строка.ПоАбонементу = ОстаткиАбонементов.СписатьСАбонемента(Строка.Клиент, ТипыПулаЗанятий.Групповые, Количество, Дата) != Неопределено
        ;
    иначе
        ПоАбонементу = ОстаткиАбонементов.СписатьСАбонемента(Клиент, ТипыПулаЗанятий.Индивидуальные, Количество, Дата) != Неопределено
    ;
;

@Обработчик
метод ПослеЗаписи(До: Занятие.Данные, ПараметрыЗаписи: Занятие.ПараметрыЗаписи)
    знч ДвиженияОстатков = новый ОстаткиАбонементов.НаборЗаписей()
    ДвиженияОстатков.Фильтр.Установить(Регистратор = Ссылка)

    знч ДвиженияВыручки = новый Выручка.НаборЗаписей()
    ДвиженияВыручки.Фильтр.Установить(Регистратор = Ссылка)

    если не Отменено
        если Формат == ФорматыЗанятий.Групповое
            для Строка из Участники
                ОтразитьОплатуКлиента(Строка.Клиент, ТипыПулаЗанятий.Групповые, ДвиженияОстатков, ДвиженияВыручки)
            ;
        иначе
            ОтразитьОплатуКлиента(Клиент, ТипыПулаЗанятий.Индивидуальные, ДвиженияОстатков, ДвиженияВыручки)
        ;
    ;

    ДвиженияОстатков.Записать()
    ДвиженияВыручки.Записать()
;

// Списывает с абонемента клиента нужное число занятий (Количество документа); если не хватило -
// проводит оплату деньгами на всю сумму (частичное списание не делается, см. докстрою проекта)
метод ОтразитьОплатуКлиента(Клиент: Клиенты.Ссылка?, ТипПула: ТипыПулаЗанятий, ДвиженияОстатков: ОстаткиАбонементов.НаборЗаписей, ДвиженияВыручки: Выручка.НаборЗаписей)
    знч Лоты = ОстаткиАбонементов.СписатьСАбонемента(Клиент, ТипПула, Количество, Дата)
    если Лоты != Неопределено
        для Лот из Лоты
            ДвиженияОстатков.ДобавитьЗапись(
                Период = Дата,
                ВидЗаписи = ВидЗаписиРегистраНакопления.Расход,
                Клиент = Клиент,
                Абонемент = Лот.Абонемент,
                ТипПула = ТипПула,
                КоличествоЗанятий = Лот.Количество
            )
        ;
    иначе
        ДвиженияВыручки.ДобавитьЗапись(
            Период = Дата,
            Клиент = Клиент,
            Сумма = Цена
        )
    ;
;
